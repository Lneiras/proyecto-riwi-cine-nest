# ==========================================
# CINE RIWI - VARIABLES DE ENTORNO (SOLO EJEMPLOS LOCALES)
# No use estos valores en produccion ni almacene secretos reales en Git.
# ==========================================

# Puerto de la API
PORT=3000
NODE_ENV=development

# Configuracion de PostgreSQL (Aplicacion)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_me_local_only
DB_DATABASE=cine_riwi
DB_SYNCHRONIZE=true

# Configuracion de pgAdmin (Entorno Dev)
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@riwi.com
PGADMIN_DEFAULT_PASSWORD=admin1234

# Configuracion JWT y Autenticacion (HU-007)
JWT_SECRET=change_me_with_a_long_random_value
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_with_another_long_random_value
JWT_REFRESH_EXPIRES_IN=7d

# Configuracion de SonarQube y su base de datos
SONAR_PORT=9000
SONAR_DB_USER=sonar
SONAR_DB_PASSWORD=change_me_local_only
SONAR_DB_NAME=sonar
SONAR_TOKEN=change_me_local_only

# Configuracion de Jenkins
JENKINS_PORT=8080
JENKINS_AGENT_PORT=50000

# Despliegue CD local (Jenkins genera .env.deploy desde Credentials)
DEPLOY_PORT=3001
APP_IMAGE=riwi-cine-api
IMAGE_TAG=local
